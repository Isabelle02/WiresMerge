      \u043F\u0440\u043E\u043F\u0440\u0438\u0435\u0442\u0430\u0440\u043D\u0430\u044F
      \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0430, \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u0432\u044B\u0441\u043E\u0441\u0430\u043B\u0430 \u043B\u0438\u0448\u043D\u044E\u044E
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E. \u041C\u044B \u0442\u0435\u0440\u044F\u0435\u043C
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E \u0432 \u0433\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u043E\u0439
