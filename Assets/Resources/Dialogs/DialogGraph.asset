    IsCorrect: 1
    ParentIds: 3a000000
    ChildrenIds: 3e000000
  - Id: 62
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u0410 \u0442\u0430\u043A \u044F \u043C\u043E\u0433\u0443 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C,
      \u0447\u0442\u043E \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0431\u044B\u043B\u0430
      \u043D\u0435\u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u0430: \u043C\u043D\u043E\u0433\u0438\u0435
      \u0443\u0437\u043B\u044B \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0438
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0438\u0442\u0430\u043D\u0438\u044F,
      \u0447\u0435\u043C \u044F \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B.  "
