  - Id: 61
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u041D\u0443 \u0447\u0442\u043E \u043C\u043E\u0433\u043B\u043E \u043F\u043E\u0439\u0442\u0438
      \u043D\u0435 \u0442\u0430\u043A. \u0420\u0430\u0441\u0447\u0435\u0442\u044B,
      \u043A\u043E\u043D\u0435\u0447\u043D\u043E! \u041F\u0440\u0438\u0434\u0435\u0442\u0441\u044F
      \u0432\u0441\u0451 \u043F\u0435\u0440\u0435\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0438 \u043C\u043D\u043E\u0433\u043E\u0435 \u2013 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E\u0435
      \u2013 \u043F\u0435\u0440\u0435\u0434\u0435\u043B\u0430\u0442\u044C."
    IsPlayer: 0
    Parameters: 
