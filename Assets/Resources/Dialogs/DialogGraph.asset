  - Id: 179
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u0412\u043E\u0442 \u0438 \u0445\u043E\u0440\u043E\u0448\u043E. \u0412\u043C\u0435\u0441\u0442\u0435
      \u0434\u043E\u043B\u0433\u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435. \u0425\u043E\u0442\u044F \u043A\u0442\u043E
      \u0442\u0443\u0442 \u043A\u043E\u043C\u0443 \u043F\u043E\u043C\u0430\u0433\u0435\u0442,
      \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u044F, \u0447\u044C\u044F \u0432\u0438\u043D\u0430
      \u0432 \u043F\u0440\u043E\u0432\u0430\u043B\u0435."
    IsPlayer: 0
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: b0000000b1000000
    ChildrenIds: b4000000
  - Id: 180
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u0417\u0430\u043F\u043E\u043C\u043D\u0438: \u0432\u0435\u043B\u0438\u043A\u0438\u0435
      \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F \u0442\u0440\u0435\u0431\u0443\u044E\u0442
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0433\u0435\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438,
      \u043D\u043E \u0438 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u044B."
    IsPlayer: 0
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: b3000000
    ChildrenIds: b5000000
  - Id: 181
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u0421 \u044D\u0442\u043E\u0433\u043E \u043C\u043E\u043C\u0435\u043D\u0442\u0430
      \u0442\u044B \u043E\u0431\u044F\u0437\u0430\u043D \u0441\u043B\u0435\u0434\u0438\u0442\u044C
      \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0439 \u043C\u0435\u043B\u043E\u0447\u044C\u044E.
      \u0418\u043D\u0430\u0447\u0435 \u043C\u044B \u043E\u0431\u0430 \u043F\u043E\u0433\u0440\u044F\u0437\u043D\u0435\u043C
      \u0432 \u0434\u043E\u043B\u0433\u0430\u0445."
    IsPlayer: 0
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: b4000000
    ChildrenIds: b6000000
  - Id: 182
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u2026\u0410 \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043C\u043E\u0433\u0438
      \u043C\u043D\u0435 \u0441\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u043B\u0430\u043D,
