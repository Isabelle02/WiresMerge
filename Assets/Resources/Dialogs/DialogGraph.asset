    IsCorrect: 1
    ParentIds: c1000000
    ChildrenIds: 
  - Id: 198
    Speaker: Question
    Text: "\u0412\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435 \u043F\u043E
      \u0434\u0435\u043B\u0430\u043C, \u043F\u0440\u0438\u0431\u043E\u0440\u044B
      \u043D\u0435 \u043D\u0443\u0436\u043D\u044B \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0435
      3 \u0447\u0430\u0441\u0430. \u0427\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C?"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 199
    Speaker: Answer
    Text: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432\u0441\u0451 \u0432\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u043C
      \u2013 \u0432\u0434\u0440\u0443\u0433 \u0447\u0442\u043E-\u0442\u043E \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F
      \u042D\u043D\u0437\u043E."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 200
    Speaker: Answer
    Text: "\u041F\u0435\u0440\u0435\u043A\u0438\u043D\u0443\u0442\u044C \u043F\u0438\u0442\u0430\u043D\u0438\u0435
      \u043D\u0430 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u044B\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432 \u0440\u0435\u0436\u0438\u043C\u0435
      \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 201
    Speaker: Answer
    Text: "\u0412\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043F\u0440\u0438\u0431\u043E\u0440\u044B
      \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432 \u044D\u043D\u0435\u0440\u0433\u043E\u0441\u0431\u0435\u0440\u0435\u0433\u0430\u044E\u0449\u0438\u0439
      \u0440\u0435\u0436\u0438\u043C \u0442\u0435, \u0447\u0442\u043E \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u043F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u043A \u043F\u043E\u0437\u0436\u0435."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 202
    Speaker: Answer
    Text: "\u041E\u0442\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0438\u0442\u0430\u043D\u0438\u0435 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430,
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043E\u0431\u043E\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043B\u044C
