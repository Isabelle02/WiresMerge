  - Id: 44
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u0415\u0441\u043B\u0438 \u043E \u0442\u0432\u043E\u0438\u0445 \u0441\u0445\u0435\u043C\u0430\u0445,
      \u0442\u043E, \u043D\u0430\u0434\u0435\u044E\u0441\u044C, \u043E\u0434\u043D\u0430
      \u0438 \u043F\u043E \u043C\u0435\u043B\u043E\u0447\u043E\u0432\u043A\u0435.
      \u0411\u0443\u0434\u0435\u0448\u044C \u043C\u043D\u0435 \u043E\u0442\u0432\u0435\u0440\u0442\u043A\u0438
      \u043F\u043E\u0434\u0430\u0432\u0430\u0442\u044C."
    IsPlayer: 0
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 2b000000
    ChildrenIds: 27000000
  - Id: 45
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u041E\u0433\u043B\u044F\u043D\u0438\u0441\u044C \u0438 \u0443\u0432\u0438\u0434\u0438\u0448\u044C,
      \u0447\u0442\u043E \u0432\u0441\u0451 \u043F\u043E\u0447\u0442\u0438 \u0433\u043E\u0442\u043E\u0432\u043E.
      \u041F\u043E\u0434\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0432 \u043E\u0434\u043D\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435, \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0434\u0440\u0443\u0433\u043E\u0435, \u0434\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0442\u0440\u0435\u0442\u044C\u0435. \u0410 \u043F\u043E\u0442\u043E\u043C
      \u043C\u044B \u0443\u0432\u0438\u0434\u0438\u043C \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442!"
    IsPlayer: 0
