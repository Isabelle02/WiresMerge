  - Id: 193
    Speaker: Question
    Text: "\u0412 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
      \u0434\u0432\u0430 \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u043F\u0440\u043E\u0436\u0435\u043A\u0442\u043E\u0440\u0430
      \u043E\u0441\u0432\u0435\u0449\u0430\u044E\u0442 \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0430\u0446\u0438\u043E\u043D\u043D\u0443\u044E
      \u0437\u043E\u043D\u0443."
    IsPlayer: 0
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: c2000000c3000000c4000000c5000000
  - Id: 194
    Speaker: Answer
    Text: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432\u0441\u0451 \u043A\u0430\u043A
      \u0435\u0441\u0442\u044C \u0434\u043B\u044F \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u0438."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: c1000000
    ChildrenIds: 
  - Id: 195
    Speaker: Answer
    Text: "\u0412\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043E\u0434\u0438\u043D
      \u043F\u0440\u043E\u0436\u0435\u043A\u0442\u043E\u0440 \u0438 \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u044C
      \u044F\u0440\u043A\u043E\u0441\u0442\u044C \u0432\u0442\u043E\u0440\u043E\u0433\u043E."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: c1000000
    ChildrenIds: 
  - Id: 196
    Speaker: Answer
    Text: "\u0412\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043E\u0431\u0430
      \u043F\u0440\u043E\u0436\u0435\u043A\u0442\u043E\u0440\u0430 \u0438 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C
      \u0434\u0432\u0435 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043D\u044B\u0435
      \u043B\u0430\u043C\u043F\u044B."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: c1000000
    ChildrenIds: 
  - Id: 197
    Speaker: Answer
    Text: "\u041F\u0440\u043E\u0442\u044F\u043D\u0443\u0442\u044C \u0443\u0434\u043B\u0438\u043D\u0438\u0442\u0435\u043B\u044C
      \u043D\u0430 \u0443\u043B\u0438\u0446\u0443 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u0440\u0430\u0431\u043E\u0442\u0443 \u043F\u043E\u0434 \u0444\u043E\u043D\u0430\u0440\u0451\u043C."
