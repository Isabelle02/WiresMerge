  - Id: 175
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u0415\u0441\u043B\u0438 \u0432\u043E\u0437\u044C\u043C\u0451\u0448\u044C
      \u0447\u0430\u0441\u0442\u044C \u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u043D\u0430 \u0441\u0435\u0431\u044F \u2013 \u044F \u043F\u043E\u0437\u0432\u043E\u043B\u044E
      \u0442\u0435\u0431\u0435 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043C\u043E\u0438\u043C
