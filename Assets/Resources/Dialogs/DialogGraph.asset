    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 230
    Speaker: Answer
    Text: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0438\u0445
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0431\u0449\u0443\u044E \u0440\u043E\u0437\u0435\u0442\u043A\u0443
      \u0441 \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u0435\u043C."
    IsPlayer: 1
