  - Id: 20
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u0431\u0430\u0437\u043E\u0432\u0430\u044F
      \u043B\u043E\u0433\u0438\u043A\u0430 \u0443 \u0442\u0435\u0431\u044F \u043D\u0430
      \u043C\u0435\u0441\u0442\u0435. \u041F\u0440\u043E\u0432\u043E\u0434\u0430
      \u0441\u043F\u0430\u044F\u043D\u044B \u0431\u0435\u0437 \u0443\u0442\u0435\u0447\u0435\u043A,
      \u0434\u0430\u043D\u043D\u044B\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442
      \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E, \u0430 \u0442\u043E\u043A
      \u0438\u0434\u0451\u0442 \u0431\u0435\u0437 \u043F\u043E\u043C\u0435\u0445."
    IsPlayer: 0
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 1500000016000000
