  - Id: 231
    Speaker: Answer
    Text: "\u0412\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 232
    Speaker: Answer
    Text: "\u0423\u0431\u0440\u0430\u0442\u044C \u0432\u0441\u0435 \u0432 \u0448\u043A\u0430\u0444
      \u0438 \u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C \u043E\u0431\u043E\u0439\u0442\u0438\u0441\u044C
      \u0431\u0435\u0437 \u043D\u0438\u0445."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 233
    Speaker: Question
    Text: "\u0412\u044B \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0442\u0435
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043F\u0435\u0440\u0435\u0440\u044B\u0432
      (30 \u043C\u0438\u043D\u0443\u0442). \u0427\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C
      \u0441 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438?"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 234
    Speaker: Answer
    Text: "\u0412\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043D\u0435\u043D\u0443\u0436\u043D\u044B\u0435
      \u043F\u0440\u0438\u0431\u043E\u0440\u044B \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u041F\u041A \u0432 \u0441\u043F\u044F\u0449\u0438\u0439 \u0440\u0435\u0436\u0438\u043C."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 235
    Speaker: Answer
    Text: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432\u0441\u0451 \u0432\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u043C,
      \u0432\u0435\u0434\u044C \u0441\u043A\u043E\u0440\u043E \u0432\u0435\u0440\u043D\u0451\u0442\u0435\u0441\u044C."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 236
    Speaker: Answer
    Text: "\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0444\u043E\u043D\u043E\u0432\u0443\u044E
      \u043C\u0443\u0437\u044B\u043A\u0443 \u043D\u0430 \u043A\u043E\u043B\u043E\u043D\u043A\u0430\u0445
      \u2013 \u0447\u0442\u043E\u0431\u044B \u0432\u0440\u0435\u043C\u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u043F\u0440\u043E\u0448\u043B\u043E."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 237
    Speaker: Answer
    Text: "\u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043D\u0430
      \xAB\u043D\u043E\u0447\u043D\u043E\u0439 \u0440\u0435\u0436\u0438\u043C\xBB,
      \u0433\u0434\u0435 \u0432\u0441\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0432 \u043F\u043E\u043B\u0441\u0438\u043B\u044B."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 238
    Speaker: Question
    Text: "\u0412\u044B \u0432\u0430\u0440\u0438\u0442\u0435 \u0435\u0434\u0443 \u043D\u0430
      \u043F\u0435\u0440\u0435\u043A\u0443\u0441, \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
      \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u043F\u043B\u0438\u0442\u0443. \u041A\u0430\u043A \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u044D\u043A\u043E\u043D\u043E\u043C\u043D\u0435\u0435?"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 239
    Speaker: Answer
    Text: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u0430\u0441\u0442\u0440\u044E\u043B\u044E
      \u043D\u0430 \u043F\u043B\u0438\u0442\u0435 \u0441 \u043F\u043E\u043B\u043D\u043E\u0439
      \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C\u044E \u043D\u0430 \u0432\u0441\u0451
      \u0432\u0440\u0435\u043C\u044F."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 240
    Speaker: Answer
    Text: "\u0420\u0430\u0437\u043E\u0433\u0440\u0435\u0442\u044C \u0434\u043E \u043A\u0438\u043F\u0435\u043D\u0438\u044F
      \u0438 \u0437\u0430\u0442\u0435\u043C \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
      \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u0443\u044E \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C
      \u043F\u043B\u0438\u0442\u044B."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 241
    Speaker: Answer
    Text: "\u0412\u0430\u0440\u0438\u0442\u044C \u0441 \u0441\u0430\u043C\u043E\u0433\u043E
      \u043D\u0430\u0447\u0430\u043B\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430
      \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 242
    Speaker: Answer
    Text: "\u0420\u0430\u0437\u0432\u0435\u0441\u0442\u0438 \u043A\u043E\u0441\u0442\u0451\u0440
      \u0438 \u0441\u0432\u0430\u0440\u0438\u0442\u044C \u043F\u043E\u0434 \u043E\u0433\u043D\u0451\u043C."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 243
    Speaker: Question
    Text: "\u042D\u043D\u0437\u043E \u043F\u0440\u0438\u043D\u0451\u0441 \u043D\u043E\u0432\u044B\u0439
      \u0443\u043C\u043D\u044B\u0439 \u0443\u0434\u043B\u0438\u043D\u0438\u0442\u0435\u043B\u044C
      \u0441 \u0444\u0443\u043D\u043A\u0446\u0438\u0435\u0439 \u0442\u0430\u0439\u043C\u0435\u0440\u0430.
      \u041A\u0430\u043A \u0435\u0433\u043E \u043B\u0443\u0447\u0448\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C?"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 244
    Speaker: Answer
    Text: "\u041D\u0435 \u0442\u0440\u043E\u0433\u0430\u0442\u044C \u2013 \u044D\u0442\u043E
      \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u043E\u0434\u043D\u0430\u044F \u0438\u0433\u0440\u0443\u0448\u043A\u0430."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 245
    Speaker: Answer
    Text: "\u041D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435 \u0434\u043B\u044F
      \u043F\u0440\u0438\u0431\u043E\u0440\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u043D\u043E\u0447\u044C\u044E."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 246
    Speaker: Answer
    Text: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043A \u043D\u0435\u043C\u0443
      \u0432\u0441\u0435 \u043B\u0430\u043C\u043F\u044B \u0438 \u0434\u0435\u043B\u0435\u0433\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u0438\u043D\u044F\u0442\u0438\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0439."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 247
    Speaker: Answer
    Text: "\u0412\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u0442\u0430\u0439\u043C\u0435\u0440
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u0432\u044B\u0445\u043E\u0434\u043D\u044B\u043C."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 248
    Speaker: Question
    Text: "\u0412\u044B \u0438 \u042D\u043D\u0437\u043E \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0435 \u043F\u0440\u0438\u0431\u043E\u0440\u044B
      \u0432 \u043E\u0434\u043D\u043E \u0438 \u0442\u043E \u0436\u0435 \u0432\u0440\u0435\u043C\u044F.
      \u041A\u0430\u043A\u043E\u0439 \u043F\u043E\u0434\u0445\u043E\u0434 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439?"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 249
    Speaker: Answer
    Text: "\u041F\u0443\u0441\u0442\u044C \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043B\u0430\u0435\u0442
      \u043A\u0430\u043A \u0443\u0434\u043E\u0431\u043D\u043E \u2013 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u044F
      \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u0430 \u043D\u0430 \u044D\u0442\u043E."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 250
    Speaker: Answer
    Text: "\u0423\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0441\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u0435
      \xAB\u043A\u0442\u043E \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\xBB
      \u2013 \u044D\u0442\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0435\u0442
      \u0431\u043E\u0435\u0432\u043E\u0439 \u0434\u0443\u0445."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 251
    Speaker: Answer
    Text: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043A\u043E\u043C\u043C\u0443\u043D\u0438\u043A\u0430\u0442\u043E\u0440,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u0431\u043E\u0440\u044B \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E Wi\u2011Fi."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 252
    Speaker: Answer
    Text: "\u041A\u043E\u043E\u0440\u0434\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0441\u0442\u0430\u0440\u0442, \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0442\u044C
      \u043F\u0438\u043A\u043E\u0432\u0443\u044E \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443
      \u0438 \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435
      \u0437\u0430\u043F\u0443\u0441\u043A\u0430"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 253
    Speaker: Question
    Text: "\u041A\u043E\u043C\u043D\u0430\u0442\u043D\u044B\u0435 \u0441\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A\u0438
      \u043B\u044E\u043C\u0438\u043D\u0435\u0441\u0446\u0435\u043D\u0442\u043D\u044B\u0435,
      \u0441\u0442\u0430\u0440\u044B\u0435, \u043F\u043E\u0442\u0440\u0435\u0431\u043B\u044F\u044E\u0442
      \u043C\u043D\u043E\u0433\u043E. \u0427\u0442\u043E \u043B\u0443\u0447\u0448\u0435?"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 254
    Speaker: Answer
    Text: "\u0417\u0430\u043C\u0435\u043D\u0438\u0442\u044C \u043D\u0430 LED\u2011\u043B\u0430\u043C\u043F\u044B
      \u0441 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0435\u0439 \u0446\u0432\u0435\u0442\u043E\u0432\u043E\u0439
      \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u043E\u0439 \u0438
      \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u044D\u043D\u0435\u0440\u0433\u043E\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 255
    Speaker: Answer
    Text: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u2013 \u0437\u0430\u043C\u0435\u043D\u0430
      \u0434\u043E\u0440\u043E\u0433\u043E \u0441\u0442\u043E\u0438\u0442."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 256
    Speaker: Answer
    Text: "\u0412\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u043B\u0430\u043C\u043F,
      \u0447\u0442\u043E\u0431\u044B \u0431\u044B\u043B\u043E \u043F\u043E\u043B\u0443\u043C\u0440\u0430\u0447\u043D\u043E,
      \u043D\u043E \u0443\u044E\u0442\u043D\u043E."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 257
    Speaker: Answer
    Text: "\u041A\u0440\u0430\u0441\u0438\u0442\u044C \u043B\u0430\u043C\u043F\u044B
      \u0432 \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u2014 \u043C\u0435\u043D\u044C\u0448\u0435
      \u0432\u0438\u0434\u0438\u043C\u043E\u0433\u043E \u0441\u0432\u0435\u0442\u0430."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 258
    Speaker: Question
    Text: "\u0412 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0438
      \u0435\u0441\u0442\u044C \u043F\u0440\u0438\u0431\u043E\u0440 \u0441 \u0434\u043E\u043B\u0433\u0438\u043C
      \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u043F\u0440\u043E\u0433\u0440\u0435\u0432\u0430;
      \u043E\u043D \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u0432\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u043C
      \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E. \u0427\u0442\u043E
      \u0434\u0435\u043B\u0430\u0442\u044C?"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 259
    Speaker: Answer
    Text: "\u041E\u0446\u0435\u043D\u0438\u0442\u044C \u044D\u043D\u0435\u0440\u0433\u043E\u0437\u0430\u0442\u0440\u0430\u0442\u044B,
      \u043F\u0440\u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u0442\u0430\u0439\u043C\u0435\u0440
      \u0438 \u0442\u0435\u043F\u043B\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044E."
