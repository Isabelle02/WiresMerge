  - Id: 203
    Speaker: Question
    Text: "\u0412\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438, \u043A\u0430\u043A
      \u042D\u043D\u0437\u043E \u043D\u0435 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u043B
      \u0441\u0432\u0435\u0442 \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u0438 \u0443\u0448\u0451\u043B.
      \u0427\u0442\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E?"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 204
    Speaker: Answer
    Text: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u0430\u043A \u0435\u0441\u0442\u044C
      \u2013 \u043B\u0430\u043C\u043F\u044B \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0440\u0435\u0448\u0430\u044E\u0442."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 205
    Speaker: Answer
    Text: "\u0412\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0441\u0432\u0435\u0442;
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u042D\u043D\u0437\u043E
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0434\u0430\u0442\u0447\u0438\u043A\u0438
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0438\u043B\u0438 \u0442\u0430\u0439\u043C\u0435\u0440\u044B,
      \u043A\u043E\u0433\u0434\u0430 \u043E\u043D \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 206
    Speaker: Answer
    Text: "\u041F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C \u042D\u043D\u0437\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0443\u043A\u0430\u0437\u0430\u0442\u044C \u043D\u0430
      \u0435\u0433\u043E \u043F\u0440\u043E\u043C\u0430\u0445."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 207
    Speaker: Answer
    Text: "\u041F\u043E\u0437\u0432\u0430\u0442\u044C \u0434\u0440\u0443\u0433\u0430
      \u043C\u0430\u043B\u044F\u0440\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u0430\u0441\u0438\u0442\u044C
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443 \u0441\u0432\u0435\u0442\u043B\u0435\u0435,
      \u0447\u0442\u043E\u0431\u044B \u043B\u0430\u043C\u043F\u0430 \u043D\u0443\u0436\u043D\u0430
      \u0431\u044B\u043B\u0430 \u0440\u0435\u0436\u0435."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 208
    Speaker: Question
    Text: "\u041C\u043E\u043D\u0438\u0442\u043E\u0440 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u0434\u043B\u044F \u0447\u0442\u0435\u043D\u0438\u044F \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430,
      \u044F\u0440\u043A\u043E\u0441\u0442\u044C \u043D\u0430 100%. \u041A\u0430\u043A
      \u044D\u043A\u043E\u043D\u043E\u043C\u043D\u043E?  "
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 209
    Speaker: Answer
    Text: "\u0423\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u044C \u044F\u0440\u043A\u043E\u0441\u0442\u044C
      \u0434\u043E \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0433\u043E
      \u043D\u0438\u0437\u043A\u043E\u0433\u043E \u0443\u0440\u043E\u0432\u043D\u044F
      \u0438 \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0440\u0435\u0436\u0438\u043C
      \u044D\u043D\u0435\u0440\u0433\u043E\u0441\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u044F.  "
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 210
    Speaker: Answer
    Text: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u044F\u0440\u043A\u043E\u0441\u0442\u044C
      \u043D\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C \u2013 \u0433\u043B\u0430\u0437\u0430
      \u043F\u0440\u0438\u0432\u044B\u043A\u043D\u0443\u0442."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 211
    Speaker: Answer
    Text: "\u041E\u0442\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u044C \u043C\u043E\u043D\u0438\u0442\u043E\u0440
      \u0434\u0430\u043B\u044C\u0448\u0435 \u2013 \u0442\u043E\u0433\u0434\u0430
      \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F \u043C\u0435\u043D\u044C\u0448\u0435
      \u0441\u0432\u0435\u0442\u0430."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 212
    Speaker: Answer
    Text: "\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u044D\u043A\u0440\u0430\u043D\u043D\u0443\u044E
      \u0437\u0430\u0441\u0442\u0430\u0432\u043A\u0443 \u0441 \u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0435\u0439
      \u2013 \u043A\u0440\u0430\u0441\u0438\u0432\u043E \u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0447\u043D\u043E."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 213
    Speaker: Question
    Text: "\u0412 \u0434\u043E\u043C\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u044B\u0445
      \u0433\u0435\u043B\u0438\u043E\u0441\u0442\u0430\u0442\u043E\u0432 \u0438 \u043C\u0430\u0441\u0441\u0430
      \u043C\u0435\u043B\u043A\u0438\u0445 \u043F\u0440\u0438\u0431\u043E\u0440\u043E\u0432.
      \u041A\u0430\u043A \u0441\u043D\u0438\u0437\u0438\u0442\u044C \u043F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435?"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 214
    Speaker: Answer
    Text: "\u0412\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u0432\u0441\u0435 \u043F\u0440\u0438\u0431\u043E\u0440\u044B
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438
      \u0438 \u043E\u0442\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u043D\u0435\u043D\u0443\u0436\u043D\u044B\u0435,
      \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u044F\u0442\u044C \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 215
    Speaker: Answer
    Text: "\u041E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0432\u0441\u0451
      \u0432\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u043C \xAB\u043D\u0430
      \u0432\u0441\u044F\u043A\u0438\u0439 \u0441\u043B\u0443\u0447\u0430\u0439\xBB."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 216
    Speaker: Answer
    Text: "\u041F\u043E\u0434\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C
      \u0433\u0435\u043B\u0438\u043E\u0441\u0442\u0430\u0442\u044B \u043A \u043C\u0443\u043B\u044C\u0442\u0438\u043F\u0440\u0438\u0431\u043E\u0440\u0443
      \xAB\u0441\u0443\u043F\u0435\u0440-\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0438\xBB."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 217
    Speaker: Answer
    Text: "\u041F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u043F\u0440\u0438\u0431\u043E\u0440\u044B
      \u0432 \u043D\u043E\u0447\u044C \u043D\u0430 \xAB\u0440\u0435\u0436\u0438\u043C
      \u0442\u0438\u0448\u0438\u043D\u044B\xBB, \u0442\u043E\u0433\u0434\u0430 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u044D\u043D\u0435\u0440\u0433\u0438\u044F
      \u0438\u0441\u0447\u0435\u0437\u043D\u0435\u0442."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 218
    Speaker: Question
    Text: "\u042D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442 \u043D\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0440\u0435\u0437\u0435\u0440\u0432\u043D\u043E\u043C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0435
      \u043F\u0438\u0442\u0430\u043D\u0438\u044F, \u043D\u043E \u043E\u043D \u044D\u043D\u0435\u0440\u0433\u043E\u0437\u0430\u0442\u0440\u0430\u0442\u0435\u043D.
      \u041A\u0430\u043A \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u0442\u044C?"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 219
    Speaker: Answer
    Text: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0441\u043E\u0441\u0435\u0434\u0435\u0439
      \u043F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E\u043C."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 220
    Speaker: Answer
    Text: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043F\u0438\u0442\u0430\u043D\u0438\u0435 \u043E\u0442 \u0441\u0432\u043E\u0435\u0433\u043E
      \u043D\u043E\u0443\u0442\u0431\u0443\u043A\u0430."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 221
    Speaker: Answer
    Text: "\u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0440\u0435\u0437\u0435\u0440\u0432
      \u043D\u0430 \u043F\u043E\u043B\u043D\u0443\u044E \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u043F\u0440\u0435\u0440\u0432\u0430\u043B\u043E\u0441\u044C."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 222
    Speaker: Answer
    Text: "\u041E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C \u043F\u0438\u0442\u0430\u043D\u0438\u0435
      \u0436\u0438\u0437\u043D\u0435\u043D\u043D\u043E \u0432\u0430\u0436\u043D\u044B\u0445
      \u0441\u0438\u0441\u0442\u0435\u043C, \u0437\u0430\u0442\u0435\u043C \u043A\u0440\u0438\u0442\u0438\u0447\u043D\u044B\u0445
      \u0447\u0430\u0441\u0442\u0435\u0439 \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0430,
      \u0441\u043D\u0438\u0437\u0438\u0432 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0438
      \u0434\u043B\u044F \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E\u0441\u0442\u0438."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 223
    Speaker: Question
    Text: "\u0412 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438 \u0441\u0442\u043E\u0438\u0442
      \u0438\u043D\u0444\u0440\u0430\u043A\u0440\u0430\u0441\u043D\u044B\u0439 \u043E\u0431\u043E\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043B\u044C
      \u0438 \u043A\u043E\u043D\u0434\u0438\u0446\u0438\u043E\u043D\u0435\u0440 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E.
      \u041A\u0430\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0434\u043B\u044F \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0438?"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 224
    Speaker: Answer
    Text: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043E\u0431\u0430, \u043F\u0443\u0441\u0442\u044C
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430 \u0441\u043E\u0433\u0440\u0435\u0432\u0430\u044E\u0442/\u043E\u0445\u043B\u0430\u0436\u0434\u0430\u044E\u0442."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 225
    Speaker: Answer
    Text: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0443\u044E
      \u0441\u0438\u0441\u0442\u0435\u043C\u0443 \u0438 \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0443; \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0442\u044C
      \u043B\u0438\u0448\u043D\u0435\u0435."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 226
    Speaker: Answer
    Text: "\u0412\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0442\u043E\u0440
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u2013 \u043F\u0443\u0441\u0442\u044C
      \xAB\u0441\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u044E\u0442\xBB."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 227
    Speaker: Answer
    Text: "\u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043E\u0431\u0430
      \u043D\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C."
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 0
    ParentIds: 
    ChildrenIds: 
  - Id: 228
    Speaker: Question
    Text: "\u041D\u0430 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u043E\u043C
      \u0441\u0442\u043E\u043B\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043C\u0435\u043B\u043A\u0438\u0445 \u043F\u0440\u0438\u0431\u043E\u0440\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0440\u0435\u0434\u043A\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F.
      \u041A\u0430\u043A \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u0442\u044C?"
    IsPlayer: 1
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 
    ChildrenIds: 
  - Id: 229
    Speaker: Answer
    Text: "\u041E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0432\u043A\u043B\u044E\u0447\u0451\u043D\u043D\u044B\u043C\u0438
      \u2013 \u0443\u0434\u043E\u0431\u043D\u0435\u0435."
