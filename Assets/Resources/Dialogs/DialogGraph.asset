  - Id: 26
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u041F\u043E\u043A\u0430 \u0435\u0449\u0451 \u043D\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0435
      \u043F\u0443\u0442\u0438. \u0410 \u0442\u044B \u0441\u043E\u0431\u0440\u0430\u043B
      \u043B\u0438\u0448\u044C \u043D\u0435\u043D\u0443\u0436\u043D\u044B\u0439 \u043A\u0443\u0441\u043E\u043A
      \u043C\u0435\u0442\u0430\u043B\u043B\u0430. \u0425\u043E\u0442\u044F, \u043C\u043E\u0436\u0435\u0442,
      \u0438 \u0432\u0441\u0443\u043D\u0443 \u043A\u0443\u0434\u0430, \u0435\u0441\u043B\u0438
      \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F."
    IsPlayer: 0
    Parameters: 
    Conditions: 
    IsCorrect: 1
    ParentIds: 19000000
    ChildrenIds: 1b000000
  - Id: 27
    Speaker: "\u042D\u043D\u0437\u043E \u0424\u0430\u0440\u043D"
    Text: "\u0422\u0435\u0431\u0435 \u043F\u043E\u0440\u0430 \u0440\u0430\u0437\u043E\u0433\u043D\u0430\u0442\u044C\u0441\u044F.
